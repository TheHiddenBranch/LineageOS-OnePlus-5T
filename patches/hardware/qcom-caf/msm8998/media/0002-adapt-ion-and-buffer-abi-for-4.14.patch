diff --git a/mm-video-v4l2/vidc/common/inc/vidc_ion_compat.h b/mm-video-v4l2/vidc/common/inc/vidc_ion_compat.h
new file mode 100644
index 0000000..1b84c51
--- /dev/null
+++ b/mm-video-v4l2/vidc/common/inc/vidc_ion_compat.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef VIDC_ION_COMPAT_H
+#define VIDC_ION_COMPAT_H
+
+#include <linux/msm_ion.h>
+
+#if TARGET_ION_ABI_VERSION >= 2
+#include <linux/dma-buf.h>
+#include <linux/ion.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+
+// This vendor kernel enables CONFIG_ION_LEGACY and handles these requests in
+// ion-ioctl.c. Use its old allocation layout and ioctl, not the ABI v2 layout.
+#define ion_allocation_data ion_old_allocation_data
+#undef ION_IOC_ALLOC
+#define ION_IOC_ALLOC ION_OLD_IOC_ALLOC
+#define ION_IOC_FREE _IOWR(ION_IOC_MAGIC, 1, struct ion_handle_data)
+#define ION_IOC_MAP _IOWR(ION_IOC_MAGIC, 2, struct ion_fd_data)
+#define ION_IOC_IMPORT _IOWR(ION_IOC_MAGIC, 5, struct ion_fd_data)
+#define ION_SECURE ION_FLAG_SECURE
+#define ION_IOMMU_HEAP_ID ION_SYSTEM_HEAP_ID
+
+// These are internal cache-operation selectors, sent through DMA_BUF_IOCTL_SYNC.
+#define VIDC_CACHE_CLEAN DMA_BUF_SYNC_END
+#define VIDC_CACHE_INVALIDATE DMA_BUF_SYNC_START
+
+static inline int vidc_ion_prefetch(int fd, uint64_t size, bool drain) {
+    struct ion_prefetch_regions region = {};
+    region.sizes = (uint64_t)(uintptr_t)&size;
+    region.vmid = ION_FLAG_CP_PIXEL;
+    region.nr_sizes = 1;
+    struct ion_prefetch_data data = {};
+    data.regions = (uint64_t)(uintptr_t)&region;
+    data.heap_id = ION_HEAP(ION_SECURE_HEAP_ID);
+    data.nr_regions = 1;
+    return ioctl(fd, drain ? ION_IOC_DRAIN : ION_IOC_PREFETCH, &data);
+}
+#else
+#define VIDC_CACHE_CLEAN ION_IOC_CLEAN_CACHES
+#define VIDC_CACHE_INVALIDATE ION_IOC_CLEAN_INV_CACHES
+#endif
+
+#endif  // VIDC_ION_COMPAT_H
