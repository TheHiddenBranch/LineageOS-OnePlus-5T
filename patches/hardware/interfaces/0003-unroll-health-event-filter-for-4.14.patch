Subject: [PATCH] Unroll the health event filter within the 4.14 instruction limit

Explicitly unroll the fixed scan window for downstream kernels without
bounded BPF loops. Reuse the zero-padded read buffer to keep the resulting
program within the 4.14 instruction limit without reducing its scan window.

diff --git a/health/utils/libhealthloop/filterPowerSupplyEvents.c b/health/utils/libhealthloop/filterPowerSupplyEvents.c
index 6f295c70983ad9c03d6bad051ada5f9861790a61..ecb4400c1ca9fa7bf1bb145d1d355bde6198c2ad 100644
--- a/health/utils/libhealthloop/filterPowerSupplyEvents.c
+++ b/health/utils/libhealthloop/filterPowerSupplyEvents.c
@@ -44,11 +44,12 @@ DEFINE_BPF_PROG("skfilter/power_supply", AID_ROOT, AID_SYSTEM, skfilter_power_su
     // The upper bound of this loop has been chosen not to exceed the maximum
     // number of instructions in a BPF program (BPF loops are unrolled).
     #define LENGTH_PREFIX 16 // length of "ACTION=\0DEVPATH="
+    // Successful reads overwrite 11 or 13 bytes; the remaining padding stays zero.
+    // Reuse this buffer to keep the unrolled program below 4096 instructions.
+    uint64_t buf[2] = {};
+    #pragma unroll
     for (uint64_t i = sizeof(struct nlmsghdr) + LENGTH_PREFIX; i < 256; ++i) {
 
-        // 16 bytes is big enough to cover both
-        uint64_t buf[2] = {};
-
         if (bpf_skb_load_bytes(skb, i, &buf, LENGTH_0SUBSYSTEM_EQUAL))
             break;  // too far -> SUBSYSTEM= not found
 
