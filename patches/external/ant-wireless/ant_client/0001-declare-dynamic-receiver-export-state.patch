Keep accepting cross-process ANT requests and Bluetooth state broadcasts while
satisfying the explicit receiver-export checks applied in the system process.

diff --git a/src/com/dsi/ant/server/AntService.java b/src/com/dsi/ant/server/AntService.java
index 0983272..408b772 100644
--- a/src/com/dsi/ant/server/AntService.java
+++ b/src/com/dsi/ant/server/AntService.java
@@ -750,12 +750,14 @@ public class AntService extends Service
                 filter.addAction(Intent.ACTION_USER_SWITCHED);
             }
         }
-        registerReceiver(mReceiver, filter);
+        // Enable/disable requests originate from ANT clients outside this process.
+        registerReceiver(mReceiver, filter, Context.RECEIVER_EXPORTED);
 
         if (mRequiresBluetoothOn) {
             IntentFilter stateChangedFilter = new IntentFilter();
             stateChangedFilter.addAction(BluetoothAdapter.ACTION_STATE_CHANGED);
-            registerReceiver(mStateChangedReceiver, stateChangedFilter);
+            // Bluetooth state broadcasts originate from the Bluetooth service's UID.
+            registerReceiver(mStateChangedReceiver, stateChangedFilter, Context.RECEIVER_EXPORTED);
         }
     }
 
