diff --git a/rootdir/etc/init.msm8998.metadata.rc b/rootdir/etc/init.msm8998.metadata.rc
new file mode 100644
index 0000000..deabbba
--- /dev/null
+++ b/rootdir/etc/init.msm8998.metadata.rc
@@ -0,0 +1,11 @@
+# SPDX-FileCopyrightText: 2026 The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+
+# No dedicated metadata partition exists. Cache is mounted by the imported
+# device fs action before this system-side action. Prepare metadata before
+# post-fs initializes Aconfig and before encrypted userdata is mounted.
+on fs
+    mkdir /cache/metadata 0771 root system
+    mount none /cache/metadata /metadata bind
+    # Repair labels left by older ROMs even when restorecon hashes still match.
+    restorecon_recursive --force /metadata
diff --git a/sepolicy/private/file_contexts b/sepolicy/private/file_contexts
new file mode 100644
index 0000000..58b8efb
--- /dev/null
+++ b/sepolicy/private/file_contexts
@@ -0,0 +1,22 @@
+# Mirror the platform metadata labels at the backing path. Both paths refer to
+# the same inodes, so recursive cache relabeling must preserve their types.
+/cache/metadata(/.*)?                             u:object_r:metadata_file:s0
+/cache/metadata/apex(/.*)?                        u:object_r:apex_metadata_file:s0
+/cache/metadata/vold(/.*)?                        u:object_r:vold_metadata_file:s0
+/cache/metadata/gsi(/.*)?                         u:object_r:gsi_metadata_file:s0
+/cache/metadata/gsi/dsu/active                    u:object_r:gsi_public_metadata_file:s0
+/cache/metadata/gsi/dsu/booted                    u:object_r:gsi_public_metadata_file:s0
+/cache/metadata/gsi/dsu/lp_names                  u:object_r:gsi_public_metadata_file:s0
+/cache/metadata/gsi/dsu/[^/]+/metadata_encryption_dir u:object_r:gsi_public_metadata_file:s0
+/cache/metadata/gsi/ota(/.*)?                     u:object_r:ota_metadata_file:s0
+/cache/metadata/password_slots(/.*)?             u:object_r:password_slot_metadata_file:s0
+/cache/metadata/ota(/.*)?                         u:object_r:ota_metadata_file:s0
+/cache/metadata/bootstat(/.*)?                    u:object_r:metadata_bootstat_file:s0
+/cache/metadata/staged-install(/.*)?              u:object_r:staged_install_file:s0
+/cache/metadata/watchdog(/.*)?                    u:object_r:watchdog_metadata_file:s0
+/cache/metadata/repair-mode(/.*)?                 u:object_r:repair_mode_metadata_file:s0
+/cache/metadata/aconfig(/.*)?                     u:object_r:aconfig_storage_metadata_file:s0
+/cache/metadata/aconfig/flags(/.*)?               u:object_r:aconfig_storage_flags_metadata_file:s0
+/cache/metadata/tradeinmode(/.*)?                 u:object_r:tradeinmode_metadata_file:s0
+/cache/metadata/prefetch(/.*)?                    u:object_r:prefetch_metadata_file:s0
+/cache/metadata/libprocessgroup(/.*)?            u:object_r:libprocessgroup_metadata_file:s0
